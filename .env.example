FLASK_APP=run.py
FLASK_ENV=development

# 必填：用 `python -c "import secrets; print(secrets.token_hex(32))"` 產生亂數字串
SECRET_KEY=
JWT_SECRET_KEY=

# 資料庫連線字串，未設定時預設使用本機 sqlite:///ecommerce.db
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ecommerce

# 允許的前端來源，以逗號分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
